
# Configuración del servidor
PUERTO=8080

# Conexión con PostgreSQL
DATABASE_URL=postgres://postgres:CAMBIE_ESTO@localhost:5433/kema_db?sslmode=disable

POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_POSTGRES

# Seguridad JWT (reemplazar por una clave local de al menos 32 caracteres)
JWT_SECRET=CAMBIE_ESTA_CLAVE_POR_UNA_DE_32_CARACTERES

# Contraseñas para usuarios de demostración (configurar localmente)
DEMO_ADMIN_PASSWORD=CAMBIAR_CONTRASENA_ADMIN
DEMO_USER_PASSWORD=CAMBIAR_CONTRASENA_USUARIO

# Tiempo de espera
TIEMPO_ESPERA_SEGUNDOS=5
